{
  "$description": "Tokens de la landing de E-commerce Headless. Estilo limpio y aireado (referencia Elementor): neutros cálidos + negro bold + naranja de acento. Regenerar: node scripts/tokens-to-css.mjs landings/ecommerce/tokens.json landings/ecommerce/tokens.css --prefix lp",
  "$extensions": { "cl.alkance.tokens": { "prefix": "lp" } },

  "color": {
    "$type": "color",
    "$description": "Primitivos. Neutros cálidos casi negros + naranja de marca + verde.",
    "ink": {
      "950": { "$value": "#0B0B0C", "$description": "Negro de titulares." },
      "900": { "$value": "#141416" },
      "800": { "$value": "#1F1F22" },
      "700": { "$value": "#33333A" },
      "500": { "$value": "#55555E" },
      "400": { "$value": "#6E6E78", "$description": "Texto secundario." },
      "300": { "$value": "#9A9AA4" },
      "200": { "$value": "#D7D7D2" }
    },
    "surface": {
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#FBFBF9", "$description": "Off-white cálido." },
      "100": { "$value": "#F5F5F1", "$description": "Gris cálido de paneles." },
      "200": { "$value": "#ECECE6" },
      "border": { "$value": "#E7E7E1" }
    },
    "orange": {
      "700": { "$value": "#C24E00" },
      "600": { "$value": "#E35C00" },
      "500": { "$value": "#F6821F", "$description": "Naranja de marca (acento)." },
      "400": { "$value": "#FBAD41" },
      "300": { "$value": "#FCC98A" },
      "100": { "$value": "#FDE7CC" },
      "50": { "$value": "#FFF6EC", "$description": "Tinte suave para paneles destacados." }
    },
    "hot": { "$value": "#FF6633" },
    "accent": {
      "500": { "$value": "#E5241A", "$description": "Rojo Alkance (uso mínimo)." }
    },
    "green": {
      "600": { "$value": "#0C6B44" },
      "500": { "$value": "#128452" },
      "50": { "$value": "#E7F6EE" }
    },
    "on-dark": {
      "strong": { "$value": "#FFFFFF" },
      "muted": { "$value": "#B9B9C2" }
    }
  },

  "semantic": {
    "$type": "color",
    "$description": "Roles. Referencian primitivos por alias.",
    "bg": {
      "canvas": { "$value": "{color.surface.0}" },
      "subtle": { "$value": "{color.surface.50}" },
      "muted": { "$value": "{color.surface.100}" },
      "tint": { "$value": "{color.surface.100}" },
      "dark": { "$value": "{color.ink.950}" }
    },
    "fg": {
      "default": { "$value": "{color.ink.800}" },
      "strong": { "$value": "{color.ink.950}" },
      "muted": { "$value": "{color.ink.400}" },
      "on-dark": { "$value": "{color.on-dark.strong}" },
      "on-dark-muted": { "$value": "{color.on-dark.muted}" },
      "accent": { "$value": "{color.ink.500}" }
    },
    "brand": {
      "500": { "$value": "{color.ink.950}" },
      "600": { "$value": "{color.ink.900}" },
      "700": { "$value": "{color.ink.800}" }
    },
    "cta": {
      "bg": { "$value": "{color.ink.950}" },
      "bg-hover": { "$value": "{color.ink.800}" },
      "fg": { "$value": "#FFFFFF" }
    },
    "border": {
      "subtle": { "$value": "{color.surface.border}" },
      "strong": { "$value": "{color.ink.200}" }
    },
    "success": { "$value": "{color.green.500}" }
  },

  "gradient": {
    "$type": "other",
    "$description": "Gradientes de marca (uso puntual).",
    "brand": { "$value": "linear-gradient(120deg, #1F1F22 0%, #141416 100%)" },
    "glow": { "$value": "radial-gradient(60% 55% at 50% 0%, rgba(20,20,22,0.03) 0%, rgba(20,20,22,0) 72%)" }
  },

  "font": {
    "$description": "Tipografía. Outfit, con titulares muy bold.",
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Outfit", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Helvetica", "Arial", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "number",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "13px" },
      "sm": { "$value": "15px" },
      "base": { "$value": "17px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)" } } },
      "lg": { "$value": "20px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1.125rem, 1.03rem + 0.4vw, 1.25rem)" } } },
      "xl": { "$value": "26px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1.35rem, 1.1rem + 1vw, 1.625rem)" } } },
      "2xl": { "$value": "34px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1.75rem, 1.35rem + 1.8vw, 2.25rem)" } } },
      "3xl": { "$value": "48px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(2.1rem, 1.4rem + 3.2vw, 3rem)" } } },
      "4xl": { "$value": "70px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(2.8rem, 1.5rem + 6vw, 4.4rem)" } } },
      "5xl": { "$value": "92px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(3.4rem, 1.2rem + 9vw, 5.75rem)" } } }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 1.02 },
      "snug": { "$value": 1.12 },
      "normal": { "$value": 1.62 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "tighter": { "$value": "-0.04em" },
      "wide": { "$value": "0.02em" },
      "widest": { "$value": "0.12em" }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "Escala de espaciado (rem).",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" },
    "12": { "$value": "48px" }, "16": { "$value": "64px" }, "20": { "$value": "80px" }, "24": { "$value": "96px" }, "32": { "$value": "128px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Radios amplios y suaves (px).",
    "sm": { "$value": "10px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "22px" },
    "xl": { "$value": "30px" },
    "2xl": { "$value": "40px" },
    "pill": { "$value": "999px" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Sombras muy suaves (look aireado).",
    "xs": { "$value": { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "#1414160F" } },
    "sm": { "$value": { "offsetX": "0", "offsetY": "4px", "blur": "14px", "spread": "-6px", "color": "#14141614" } },
    "md": { "$value": { "offsetX": "0", "offsetY": "12px", "blur": "34px", "spread": "-14px", "color": "#1414161F" } },
    "lg": { "$value": { "offsetX": "0", "offsetY": "26px", "blur": "60px", "spread": "-24px", "color": "#14141626" } },
    "nav": { "$value": { "offsetX": "0", "offsetY": "8px", "blur": "30px", "spread": "-10px", "color": "#14141614" } }
  },

  "motion": {
    "$description": "Duraciones y curvas.",
    "duration": {
      "$type": "duration",
      "fast": { "$value": "160ms" }, "base": { "$value": "260ms" }, "slow": { "$value": "560ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "inout": { "$value": [0.65, 0, 0.35, 1] },
      "spring": { "$value": [0.34, 1.4, 0.64, 1] }
    }
  }
}
