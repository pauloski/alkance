{
  "$description": "Tokens propios de la landing de E-commerce Headless (contexto de venta independiente del home). Regenerar CSS con: node scripts/tokens-to-css.mjs landings/ecommerce/tokens.json landings/ecommerce/tokens.css --prefix lp",
  "$extensions": { "cl.alkance.tokens": { "prefix": "lp" } },

  "color": {
    "$type": "color",
    "$description": "Primitivos. Navy profundo + naranja Cloudflare + acento Alkance.",
    "ink": {
      "900": { "$value": "#0A1B2E", "$description": "Navy más profundo (titulares, fondos oscuros)." },
      "800": { "$value": "#10243B" },
      "700": { "$value": "#1B3A57" },
      "600": { "$value": "#284A69" },
      "500": { "$value": "#3C5A78" },
      "400": { "$value": "#5A6B7B" },
      "300": { "$value": "#8A97A6" },
      "200": { "$value": "#C3CCD6" }
    },
    "surface": {
      "0": { "$value": "#FFFFFF" },
      "50": { "$value": "#F7F9FC" },
      "100": { "$value": "#F1F5FA" },
      "200": { "$value": "#E7EDF4" },
      "border": { "$value": "#E1E8F0" }
    },
    "orange": {
      "700": { "$value": "#C24E00" },
      "600": { "$value": "#E35C00" },
      "500": { "$value": "#F6821F", "$description": "Naranja de marca (energía / Cloudflare)." },
      "400": { "$value": "#FBAD41" },
      "300": { "$value": "#FCC98A" },
      "50": { "$value": "#FFF3E6" }
    },
    "hot": { "$value": "#FF6633", "$description": "Rojo-naranja para gradientes." },
    "accent": {
      "500": { "$value": "#E5241A", "$description": "Rojo Alkance. Se usa con moderación para amarrar marca." },
      "600": { "$value": "#B8170D" }
    },
    "green": {
      "500": { "$value": "#0F7B4F" },
      "50": { "$value": "#E6F4EC" }
    },
    "on-dark": {
      "strong": { "$value": "#FFFFFF" },
      "muted": { "$value": "#B8C6D6" },
      "faint": { "$value": "#7C8DA1" }
    }
  },

  "semantic": {
    "$type": "color",
    "$description": "Roles. Nunca repiten valor: referencian primitivos por alias.",
    "bg": {
      "canvas": { "$value": "{color.surface.0}" },
      "subtle": { "$value": "{color.surface.50}" },
      "muted": { "$value": "{color.surface.100}" },
      "dark": { "$value": "{color.ink.900}" },
      "dark-raised": { "$value": "{color.ink.800}" }
    },
    "fg": {
      "default": { "$value": "{color.ink.800}" },
      "strong": { "$value": "{color.ink.900}" },
      "muted": { "$value": "{color.ink.400}" },
      "on-dark": { "$value": "{color.on-dark.strong}" },
      "on-dark-muted": { "$value": "{color.on-dark.muted}" },
      "accent": { "$value": "{color.orange.600}" }
    },
    "brand": {
      "500": { "$value": "{color.orange.500}" },
      "600": { "$value": "{color.orange.600}" },
      "700": { "$value": "{color.orange.700}" }
    },
    "border": {
      "subtle": { "$value": "{color.surface.border}" },
      "strong": { "$value": "{color.ink.200}" },
      "on-dark": { "$value": "#FFFFFF1F" }
    },
    "success": { "$value": "{color.green.500}" }
  },

  "gradient": {
    "$type": "other",
    "$description": "Gradientes de marca listos para background.",
    "brand": { "$value": "linear-gradient(120deg, #FF6633 0%, #F6821F 45%, #FBAD41 100%)" },
    "brand-soft": { "$value": "linear-gradient(120deg, #FFF3E6 0%, #FFFFFF 100%)" },
    "dark": { "$value": "linear-gradient(160deg, #10243B 0%, #0A1B2E 100%)" },
    "glow": { "$value": "radial-gradient(60% 60% at 50% 0%, rgba(246,130,31,0.18) 0%, rgba(246,130,31,0) 70%)" }
  },

  "font": {
    "$description": "Tipografía. Reutiliza Outfit del sitio.",
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Outfit", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Helvetica", "Arial", "sans-serif"] },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "number",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "black": { "$value": 800 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "13px" },
      "sm": { "$value": "15px" },
      "base": { "$value": "17px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1rem, 0.96rem + 0.2vw, 1.0625rem)" } } },
      "lg": { "$value": "20px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem)" } } },
      "xl": { "$value": "26px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1.35rem, 1.15rem + 0.9vw, 1.625rem)" } } },
      "2xl": { "$value": "34px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(1.7rem, 1.35rem + 1.6vw, 2.125rem)" } } },
      "3xl": { "$value": "46px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(2.1rem, 1.5rem + 2.8vw, 2.875rem)" } } },
      "4xl": { "$value": "64px", "$extensions": { "cl.alkance.tokens": { "fluid": "clamp(2.7rem, 1.6rem + 5vw, 4rem)" } } }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 1.05 },
      "snug": { "$value": 1.2 },
      "normal": { "$value": 1.6 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.02em" },
      "tighter": { "$value": "-0.035em" },
      "wide": { "$value": "0.02em" },
      "widest": { "$value": "0.14em" }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "Escala de espaciado (rem).",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" },
    "20": { "$value": "80px" },
    "24": { "$value": "96px" },
    "32": { "$value": "128px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Radios de borde (px, no escalan con la fuente).",
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "26px" },
    "pill": { "$value": "999px" }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Sombras.",
    "sm": { "$value": { "offsetX": "0", "offsetY": "1px", "blur": "3px", "spread": "0", "color": "#0A1B2E14" } },
    "md": { "$value": { "offsetX": "0", "offsetY": "10px", "blur": "30px", "spread": "-8px", "color": "#0A1B2E1F" } },
    "lg": { "$value": { "offsetX": "0", "offsetY": "24px", "blur": "60px", "spread": "-16px", "color": "#0A1B2E2E" } },
    "glow": { "$value": { "offsetX": "0", "offsetY": "12px", "blur": "36px", "spread": "-10px", "color": "#F6821F5C" } }
  },

  "motion": {
    "$description": "Duraciones y curvas para microinteracciones.",
    "duration": {
      "$type": "duration",
      "fast": { "$value": "160ms" },
      "base": { "$value": "260ms" },
      "slow": { "$value": "520ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] },
      "inout": { "$value": [0.65, 0, 0.35, 1] },
      "spring": { "$value": [0.34, 1.56, 0.64, 1] }
    }
  }
}
